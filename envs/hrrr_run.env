# Environment file for scripts/run_hrrr_tile.py
# Usage:
#   set -a && source envs/hrrr_run.env && set +a
#   python scripts/run_hrrr_tile.py --analysis-time 2026-07-01T12:00:00 --tile-size 256 --steps 3

# Required: HF STRATA checkpoint path
STRATA_CHECKPOINT=/absolute/path/to/checkpoints/strata_v1.pth

# Required: directory containing:
#   latlon_ne1024pg2.nc
#   scream_vertical_coordinate.nc
AUX_DATA_ROOT=/absolute/path/to/aux_data

# Optional: if using custom object store creds/profile for SCREAM zarr
# (not required for HRRR fetch from hrrrzarr)
SCREAM_ZARR_PROFILE=

# Optional run defaults (script flags override these if passed explicitly)
HRRR_ANALYSIS_TIME=2026-07-01T12:00:00
HRRR_TILE_SIZE=256
HRRR_STEPS=3
HRRR_CENTER_LAT=39.0
HRRR_CENTER_LON=-97.0
